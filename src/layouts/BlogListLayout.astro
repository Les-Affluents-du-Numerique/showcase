---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import BlogCard from "@components/BlogCard.astro";
import FeaturedBlogCard from "@components/FeaturedBlogCard.astro";

interface Props {
  title: string;
  description: string;
  gridPosts?: CollectionEntry<"blog">[];
  // Accepted from tag/pagination callers (reserved for future filter UI).
  availableTagEntries?: [string, string][];
  effectiveTag?: string;
  pageCurrent?: number;
  prevHref?: string | null;
  nextHref?: string | null;
}

const { title, description, gridPosts = [] } = Astro.props;
---

<Layout title={title} description={description}>
  <main
    id="main-content"
    class="!pt-40 md:!pt-32 pb-20 px-4 md:px-8 max-w-7xl mx-auto"
  >
    <section class="mb-20 text-left max-w-4xl">
      <span
        class="font-label text-xs uppercase tracking-[0.2em] text-primary opacity-80 mb-4 block"
        >Insights &amp; Analyses</span
      >
      <h1
        class="font-headline text-5xl md:text-7xl font-extrabold text-primary tracking-tight leading-[1.1] mb-8"
      >
        Le courant des <span class="editorial-underline">idées</span> numériques.
      </h1>
      <p
        class="font-body text-lg text-on-surface-variant leading-relaxed max-w-2xl"
      >
        {description}
      </p>
    </section>

    {
      gridPosts.length > 0 && (
        <div class="space-y-10 relative z-20">
          <FeaturedBlogCard post={gridPosts[0]} />
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {gridPosts.slice(1).map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </div>
      )
    }
  </main>
</Layout>
