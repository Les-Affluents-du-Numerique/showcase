---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import AuthorList from "@components/AuthorList.astro";
import { POST_TAGS_ENUM, type PostTagKey } from "../consts";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  thumbnailAlt,
  tags,
  authors,
  author,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  image={heroImage}
  imageAlt={thumbnailAlt ?? title}
  pageType="article"
  contentTitle={title}
  publishedDate={pubDate}
  updatedDate={updatedDate}
  authors={authors}
  author={author}
  tags={tags?.map((tag) => POST_TAGS_ENUM[tag as PostTagKey] ?? tag)}
>
  <main id="main-content" class="!pt-36 md:!pt-40">
    <article>
      <header class="mx-auto max-w-4xl px-4 pb-12 pt-8 md:px-8 md:pb-16">
        {
          tags?.length > 0 && (
            <div class="mb-6 flex flex-wrap gap-3">
              {tags.map((tag) => (
                <span class="font-label text-[10px] font-bold uppercase tracking-widest text-primary">
                  {POST_TAGS_ENUM[tag as PostTagKey] ?? tag}
                </span>
              ))}
            </div>
          )
        }
        <h1
          class="max-w-3xl font-headline text-4xl font-extrabold leading-tight tracking-tight text-primary sm:text-5xl"
        >
          {title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-on-surface-variant">
          {description}
        </p>
        <div
          class="mt-8 flex flex-wrap items-center gap-4 text-sm text-on-surface-variant"
        >
          <AuthorList authors={authors} author={author} size="md" />
          <p>
            Publié le <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <>
                  <span aria-hidden="true"> · </span>
                  Mis à jour le <FormattedDate date={updatedDate} />
                </>
              )
            }
          </p>
        </div>
      </header>

      {
        heroImage && (
          <div class="mx-auto mb-12 max-w-5xl px-4 md:mb-16 md:px-8">
            <Image
              width={1200}
              height={675}
              src={heroImage}
              alt={thumbnailAlt ?? title}
              class="aspect-video w-full rounded-2xl object-cover shadow-xl"
            />
          </div>
        )
      }

      <div class="prose mx-auto max-w-3xl px-4 pb-8 md:px-8">
        <slot />
      </div>
    </article>
  </main>
</Layout>
