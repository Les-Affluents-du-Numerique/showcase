---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import AuthorList from "@components/AuthorList.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, thumbnailAlt } =
  Astro.props;
---

<Layout title={title} description={description}>
  <style>
    .hero-image {
      width: 100%;
    }
    .hero-image img {
      display: block;
      margin: 0 auto;
      border-radius: 12px;
      box-shadow:
        0 2px 6px rgba(0, 51, 88, 0.08),
        0 8px 24px rgba(0, 51, 88, 0.1),
        0 16px 32px rgba(0, 51, 88, 0.08);
    }
    .prose {
      width: 720px;
      max-width: calc(100% - 2em);
      margin: auto;
      padding: 1em;
      color: var(--color-on-surface);
    }
    @media (max-width: 768px) {
      .prose {
        max-width: calc(100% - 1em);
        padding: 0.5em;
      }
    }
    .title {
      margin-bottom: 1em;
      padding: 1em 0;
      text-align: center;
      line-height: 1;
    }
    @media (max-width: 768px) {
      .title {
        padding: 0.5em 0;
        margin-bottom: 0.5em;
      }
    }
    .title h1 {
      margin: 0 0 0.5em 0;
      font-size: 2.25rem;
      line-height: 1.05;
      font-weight: 700;
    }
    @media (max-width: 768px) {
      .title h1 {
        font-size: 1.75rem;
        margin: 0 0 0.25em 0;
      }
    }
    .date {
      margin-bottom: 0.5em;
      color: var(--color-on-surface-variant);
    }
    .last-updated-on {
      font-style: italic;
    }
  </style>
  <main id="main-content" class="!pt-40 md:!pt-32">
    <article>
      <div class="hero-image">
        {
          heroImage && (
            <Image
              width={1020}
              height={510}
              src={heroImage}
              alt={thumbnailAlt ?? title}
            />
          )
        }
      </div>
      <div class="prose">
        <div class="title">
          <div class="date">
            <FormattedDate date={pubDate} />
            <div class="my-3">
              <AuthorList
                authors={Astro.props.authors}
                author={Astro.props.author}
                size="md"
                align="center"
              />
            </div>
            {
              updatedDate && (
                <div class="last-updated-on">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <h1>{title}</h1>
          <hr />
        </div>
        <slot />
      </div>
    </article>
  </main>
</Layout>
