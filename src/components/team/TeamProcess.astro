---
import Eyebrow from "@components/Eyebrow.astro";

const steps = [
  {
    icon: "person",
    title: "Un responsable clairement identifié",
    body: "La personne qui réalise votre projet en assure directement le suivi. Vous savez qui contacter et qui prend les décisions techniques.",
  },
  {
    icon: "description",
    title: "Un contexte de projet entretenu",
    body: "Les choix, le périmètre et les points techniques importants sont documentés pour faciliter la collaboration et un éventuel passage de relais.",
  },
  {
    icon: "sync",
    title: "Un relais en cas d'indisponibilité",
    body: "Un autre membre peut reprendre le contexte et assurer la suite du projet. Vous ne dépendez pas d'une seule personne pour avancer.",
  },
];
---

<section class="py-24 md:py-36">
  <div
    class="mx-auto grid max-w-7xl gap-14 px-4 md:px-8 lg:grid-cols-12 lg:gap-20"
  >
    <div class="lg:col-span-5">
      <Eyebrow class="mb-5">Notre fonctionnement</Eyebrow>
      <h2
        class="font-headline text-4xl font-extrabold leading-tight text-primary md:text-5xl"
      >
        La continuité prévue dès le début du projet.
      </h2>
      <p class="mt-6 max-w-md leading-7 text-on-surface-variant">
        Le projet reste suivi par la personne qui le réalise, tout en pouvant
        être repris par le collectif lorsque c'est nécessaire.
      </p>
    </div>

    <ul class="border-t border-outline-variant/50 lg:col-span-7">
      {
        steps.map((step) => (
          <li class="grid gap-4 border-b border-outline-variant/50 py-8 sm:grid-cols-[3.5rem_1fr] sm:gap-6">
            <span
              class="grid h-11 w-11 place-items-center rounded-full bg-primary-fixed text-primary"
              aria-hidden="true"
            >
              {/* prettier-ignore */}
              <span class="material-symbols-outlined text-xl">{step.icon}</span>
            </span>
            <div>
              <h3 class="font-headline text-2xl font-bold text-primary">
                {step.title}
              </h3>
              <p class="mt-3 leading-7 text-on-surface-variant">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
