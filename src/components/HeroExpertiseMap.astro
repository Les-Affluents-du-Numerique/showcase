---
import OrbitDiagram, { type OrbitNode } from "@components/OrbitDiagram.astro";

const expertises: OrbitNode[] = [
  { icon: "code", label: "Développement web" },
  { icon: "database", label: "IA & données" },
  { icon: "shield_lock", label: "Sécurité applicative" },
  { icon: "account_tree", label: "ERP & API" },
];
---

<OrbitDiagram
  variant="expertise"
  ariaLabel="Quatre expertises gravitent autour du collectif : développement web, intelligence artificielle et données, sécurité applicative, ERP et API."
  nodes={expertises}
/>
