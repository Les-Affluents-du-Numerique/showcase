---
import type { ImageMetadata } from "astro";
import OrbitDiagram, { type OrbitNode } from "@components/OrbitDiagram.astro";

interface Member {
  name: string;
  image: ImageMetadata;
}

interface Props {
  members: Member[];
}

const { members } = Astro.props;

const nodes: OrbitNode[] = members.map((member) => ({
  label: member.name,
  image: member.image,
}));
const ariaLabel = `Le collectif réunit ${members
  .map((member) => member.name)
  .join(", ")}.`;
---

<OrbitDiagram variant="team" ariaLabel={ariaLabel} nodes={nodes} />
