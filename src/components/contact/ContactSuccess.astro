---

<div
  class="contact-success absolute inset-0 hidden flex-col items-center justify-center gap-1 rounded-2xl bg-white px-6 py-12 text-center"
  role="status"
  aria-live="polite"
>
  <span class="contact-success-badge" aria-hidden="true">
    <svg viewBox="0 0 52 52" class="contact-success-check">
      <circle cx="26" cy="26" r="24" class="contact-success-ring"></circle>
      <path d="M15 27 l7 7 l15 -16" class="contact-success-tick" fill="none"
      ></path>
    </svg>
  </span>
  <h3 class="mt-6 font-headline text-2xl font-extrabold text-on-surface">
    Message bien reçu !
  </h3>
  <p
    class="contact-success-text mt-2 max-w-xs text-base leading-7 text-on-surface-variant"
  >
    Merci, nous revenons vers vous sous 24h.
  </p>
  <button
    type="button"
    class="contact-reset mt-7 inline-flex items-center gap-1.5 rounded-lg border border-[#c8d3d9] px-5 py-2.5 text-sm font-bold text-[#0d7595] transition-colors hover:bg-[#f1f8fb]"
  >
    <span class="material-symbols-outlined text-base" aria-hidden="true"
      >mail</span
    >
    Envoyer un autre message
  </button>
</div>
