---
import Eyebrow from "@components/Eyebrow.astro";
import HeroConfluence from "@components/HeroConfluence.astro";
---

<section
  id="main-content"
  class="relative min-h-screen pt-32 pb-20 flex items-center overflow-hidden bg-surface"
>
  <div
    class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center w-full"
  >
    <div class="lg:col-span-7">
      <Eyebrow class="mb-6">Collectif numérique</Eyebrow>
      <h1
        class="font-headline font-extrabold text-5xl md:text-7xl text-primary leading-[1.1] mb-8 tracking-tight"
      >
        L'excellence <br />
        <span class="text-primary-container">au confluent</span>
        <br />
        du numérique.
      </h1>
      <p
        class="font-body text-lg md:text-xl text-on-surface-variant max-w-xl mb-10 leading-relaxed"
      >
        Trois développeurs indépendants en Île-de-France. Nous concevons et
        faisons évoluer des applications web et des outils métier pour les
        entreprises de Paris et sa région.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="#contact"
          class="fluid-gradient text-on-primary px-8 py-4 rounded-lg font-semibold text-lg shadow-xl flex items-center gap-2"
        >
          Contactez-nous
          <span
            class="material-symbols-outlined"
            data-icon="arrow_forward"
            aria-hidden="true">arrow_forward</span
          >
        </a>
        <a
          href="/notre-equipe/"
          class="border border-outline-variant text-primary px-8 py-4 rounded-lg font-semibold text-lg hover:bg-surface-container transition-colors flex items-center justify-center"
        >
          Voir notre équipe
        </a>
      </div>
    </div>
    <div class="lg:col-span-5 lg:pl-4">
      <HeroConfluence />
    </div>
  </div>
</section>
