---
import Eyebrow from "@components/Eyebrow.astro";
import { Image } from "astro:assets";
import tissecoLogo from "../../assets/tisseco-logo.png";
---

<section class="bg-background py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="mb-10 md:mb-12">
      <Eyebrow>Témoignage client</Eyebrow>
      <h2
        class="mt-3 font-headline text-4xl font-extrabold tracking-tight text-primary md:text-5xl"
      >
        On vous laisse la parole.
      </h2>
    </div>

    <figure
      class="grid overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest shadow-sm md:grid-cols-[16rem_1fr]"
    >
      <figcaption
        class="border-b border-outline-variant/30 p-7 md:border-b-0 md:border-r md:p-9"
      >
        <div class="h-16 w-16 rounded-full bg-surface-container p-2">
          <Image
            class="h-full w-full rounded-full object-cover"
            alt="Logo de Tisseco Solidaire"
            src={tissecoLogo}
          />
        </div>
        <div class="mt-5 font-headline text-lg font-bold text-primary">
          Pascale Bruneau
        </div>
        <div
          class="mt-1 text-xs font-label uppercase tracking-wider text-on-surface-variant"
        >
          Présidente<br />Tisseco Solidaire
        </div>
        <div
          class="mt-6 flex gap-0.5 text-primary-container"
          role="img"
          aria-label="5 étoiles sur 5"
        >
          {
            Array.from({ length: 5 }).map(() => (
              <span
                class="material-symbols-outlined is-filled text-lg"
                aria-hidden="true"
              >
                star
              </span>
            ))
          }
        </div>
      </figcaption>

      <div class="flex flex-col justify-center p-7 sm:p-10 md:p-12 lg:p-14">
        <span
          class="material-symbols-outlined mb-5 text-4xl text-primary-container"
          aria-hidden="true">format_quote</span
        >
        <blockquote
          class="max-w-3xl font-headline text-2xl font-bold leading-snug tracking-tight text-primary sm:text-3xl"
        >
          Enfin des prestataires qui comprennent les enjeux business des petites
          structures. Un vrai partenaire de croissance.
        </blockquote>
      </div>
    </figure>
  </div>
</section>
