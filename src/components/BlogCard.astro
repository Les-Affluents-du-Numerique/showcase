---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import AuthorList from "@components/AuthorList.astro";
import { Image } from "astro:assets";
import { POST_TAGS_ENUM, type PostTagKey } from "../consts";
import placeholderImage from "../assets/blog-placeholder-1.jpg";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
---

<article
  class="group flex flex-col bg-surface-container-lowest rounded-3xl overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-primary/5"
>
  <a href={`/blog/posts/${post.id}`} class="block h-full">
    <div class="aspect-4/3 overflow-hidden">
      <Image
        src={post.data.heroImage || placeholderImage}
        alt={post.data.thumbnailAlt ||
          post.data.title ||
          "Miniature de l'article"}
        width={800}
        height={600}
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      />
    </div>
    <div class="p-8 flex flex-col grow">
      <div class="flex justify-between items-center mb-4">
        <div class="space-x-2"></div>
        <span class="font-body text-[10px] text-on-surface-variant italic"
          >{(<FormattedDate date={post.data.pubDate} />)}</span
        >
      </div>
      <h3
        class="font-headline text-xl font-bold text-primary mb-4 leading-snug group-hover:text-primary-container transition-colors"
      >
        {post.data.title}
      </h3>
      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {post.data.tags.map((t) => (
              <span class="inline-flex items-center bg-surface-container border border-surface-container text-on-secondary-fixed-variant px-3 py-1 rounded-full font-bold text-[10px] uppercase tracking-widest">
                {POST_TAGS_ENUM[t as PostTagKey] ?? t}
              </span>
            ))}
          </div>
        )
      }
      <p
        class="font-body text-sm text-on-surface-variant mb-8 line-clamp-3 leading-relaxed"
      >
        {post.data.description}
      </p>
      <div
        class="mt-auto flex items-center gap-3 pt-6 border-t border-surface-container"
      >
        <AuthorList
          authors={post.data.authors}
          author={post.data.author}
          size="sm"
        />
      </div>
    </div>
  </a>
</article>
