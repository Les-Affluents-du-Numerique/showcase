---
import Eyebrow from "@components/Eyebrow.astro";
---

<!-- Hero Section -->
<section class="relative pb-32 px-4 md:px-8 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-4xl">
      <Eyebrow class="mb-6">Nos réalisations</Eyebrow>
      <h1
        class="font-headline text-5xl md:text-7xl font-extrabold text-primary leading-[1.1] mb-8 tracking-tighter"
      >
        Des projets qui font leurs
        <span class="editorial-underline">preuves</span>.
      </h1>
      <p
        class="font-body text-xl text-on-surface-variant max-w-2xl leading-relaxed"
      >
        Nous concevons des solutions sur mesure qui allient haute technicité et
        vision stratégique pour des entreprises ambitieuses de toutes tailles.
        Découvrez comment nous accompagnons nos clients, du cadrage à la mise en
        production.
      </p>
    </div>
  </div>
</section>
