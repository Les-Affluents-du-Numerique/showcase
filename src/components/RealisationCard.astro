---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import AuthorList from "@components/AuthorList.astro";
import placeholderImage from "../assets/blog-placeholder-1.jpg";

interface Props {
  project: CollectionEntry<"realisations"> & { _slug: string };
  idx: number;
}
const { project, idx } = Astro.props;
---

<div class={idx === 0 ? "md:col-span-2 lg:col-span-2 group" : "group"}>
  <div
    class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm transition-all duration-300 hover:shadow-xl flex flex-col h-full"
  >
    {
      project.data.hero ? (
        <a href={`/realisations/${project._slug}`} class="block">
          <div
            class={
              idx === 0
                ? "h-80 md:h-96 overflow-hidden"
                : "h-56 overflow-hidden"
            }
          >
            <Image
              src={project.data.hero || placeholderImage}
              alt={
                project.data.heroAlt || project.data.title || "Image du projet"
              }
              width={idx === 0 ? 1200 : 800}
              height={idx === 0 ? 800 : 600}
              format="webp"
              quality={85}
              loading={idx === 0 ? "eager" : "lazy"}
              fetchpriority={idx === 0 ? "high" : undefined}
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
          </div>
        </a>
      ) : null
    }
    <div class="p-8">
      <a
        href={`/realisations/${project._slug}`}
        class="inline-block no-underline"
      >
        <h3 class="font-headline text-2xl font-bold text-primary mb-4">
          {project.data.title}
        </h3>
      </a>
      <p class="text-on-surface-variant mb-6 text-sm leading-relaxed">
        {project.data.description}
      </p>

      {
        project.data.authors && project.data.authors.length ? (
          <div class="flex items-center mb-4">
            <AuthorList
              authors={project.data.authors}
              size="md"
              variant="stack"
              max={3}
            />
          </div>
        ) : null
      }

      {
        project.data.tech ? (
          <div class="flex flex-wrap gap-2 mb-6">
            {project.data.tech.map((t) => (
              <span class="px-3 py-1 bg-surface-container text-on-surface-variant text-[0.7rem] font-bold rounded-full">
                {t}
              </span>
            ))}
          </div>
        ) : null
      }
      <a
        class="inline-flex items-center gap-2 text-primary font-bold text-sm hover:gap-4 transition-all"
        href={`/realisations/${project._slug}`}
      >
        Voir le projet <span
          class="material-symbols-outlined text-sm"
          aria-hidden="true">arrow_forward</span
        >
      </a>
    </div>
  </div>
</div>
