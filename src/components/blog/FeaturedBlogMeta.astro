---
import type { CollectionEntry } from "astro:content";
import AuthorList from "@components/AuthorList.astro";
import FormattedDate from "@components/FormattedDate.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<div class="space-y-5">
  <span
    class="inline-flex rounded-md bg-primary px-3 py-1 font-label text-[10px] font-bold uppercase tracking-widest text-white"
  >
    À la une
  </span>
  <p class="text-sm text-on-surface-variant">
    <FormattedDate date={post.data.pubDate} />
  </p>
  <AuthorList authors={post.data.authors} author={post.data.author} size="sm" />
</div>
