---
import { CONTACT_EMAIL } from "../consts";

const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
  "Prise de contact via le site",
)}`;

const benefits = [
  { icon: "schedule", text: "Réponse sous 24h" },
  {
    icon: "description",
    text: "Devis gratuit et détaillé après avoir précisé votre besoin",
  },
];
---

<section id="contact" class="contact-cta bg-background py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div
      class="relative overflow-hidden rounded-2xl bg-primary px-6 py-12 shadow-xl sm:px-10 lg:px-16 lg:py-18"
    >
      <div
        class="relative grid items-center gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16"
      >
        <div class="max-w-md pt-2">
          <h2
            class="font-headline text-4xl font-extrabold tracking-tight text-white md:text-5xl"
          >
            Parlons de votre projet.
          </h2>
          <p class="mt-5 text-base leading-7 text-primary-fixed md:text-lg">
            Décrivez votre projet en quelques lignes pour que nous puissions
            vous répondre au mieux et, si besoin, convenir d'un échange en
            visio.
          </p>

          <ul
            class="mt-9 space-y-4 text-sm font-semibold text-white md:text-base"
          >
            {
              benefits.map((benefit) => (
                <li class="flex items-center gap-3">
                  {/* prettier-ignore */}
                  <span class="material-symbols-outlined text-lg text-[#56c6e9]" aria-hidden="true">{benefit.icon}</span>
                  {benefit.text}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="text-left sm:rounded-2xl sm:bg-white sm:p-10 sm:shadow-2xl lg:p-12"
        >
          <!-- L'adresse ne tient pas sur une ligne en mobile : le bouton suffit. -->
          <div class="mb-8 hidden sm:block">
            <p
              class="font-label text-xs font-bold uppercase tracking-[0.14em] text-on-surface-variant"
            >
              Écrivez-nous
            </p>
            <a
              href={mailto}
              class="mt-3 block font-headline text-2xl font-bold text-primary hover:text-[#0d7595]"
            >
              {CONTACT_EMAIL}
            </a>
          </div>
          <a
            href={mailto}
            class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#0d7595] px-6 py-4 font-bold text-white transition-colors hover:bg-[#0a6383]"
          >
            Envoyer un e-mail
            {/* prettier-ignore */}
            <span class="material-symbols-outlined text-lg" aria-hidden="true"
              >arrow_forward</span
            >
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
