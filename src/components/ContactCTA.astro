---

---

<section id="contact" class="contact-cta bg-background py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div
      class="relative overflow-hidden rounded-2xl bg-primary px-6 py-12 shadow-xl sm:px-10 lg:px-16 lg:py-18"
    >
      <div
        class="absolute -left-32 -top-32 h-80 w-80 rounded-full bg-primary-container/30 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16">
        <div class="max-w-md pt-2">
          <h2
            class="font-headline text-4xl font-extrabold tracking-tight text-white md:text-5xl"
          >
            Parlons de votre projet.
          </h2>
          <p class="mt-5 text-base leading-7 text-primary-fixed md:text-lg">
            Décrivez votre projet en quelques lignes pour que nous puissions
            vous répondre au mieux et, si besoin, convenir d'un échange en
            visio.
          </p>

          <ul
            class="mt-9 space-y-4 text-sm font-semibold text-white md:text-base"
          >
            <li class="flex items-center gap-3">
              <span
                class="material-symbols-outlined text-lg text-[#56c6e9]"
                aria-hidden="true">schedule</span
              >
              Réponse sous 24h
            </li>
            <li class="flex items-center gap-3">
              <span
                class="material-symbols-outlined text-lg text-[#56c6e9]"
                aria-hidden="true">description</span
              >
              Devis gratuit et détaillé après avoir précisé votre besoin
            </li>
          </ul>
        </div>

        <div
          class="contact-panel relative rounded-2xl bg-white text-left shadow-2xl"
        >
          <form
            class="contact-form p-5 sm:p-8"
            action="/api/contact"
            method="post"
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="contact-field">
                Votre nom
                <input
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  maxlength="100"
                  placeholder="Marie Dupont"
                />
              </label>
              <label class="contact-field">
                E-mail
                <input
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  maxlength="254"
                  placeholder="marie@entreprise.fr"
                />
              </label>
              <label class="contact-field">
                Entreprise <span class="font-normal text-on-surface-variant"
                  >(facultatif)</span
                >
                <input
                  name="company"
                  type="text"
                  autocomplete="organization"
                  maxlength="150"
                  placeholder="Nom de votre structure"
                />
              </label>
              <label class="contact-field">
                Votre besoin
                <select name="projectType">
                  <option value="Créer un outil web">Créer un outil web</option>
                  <option value="Refondre un site ou une application"
                    >Refondre un site ou une application</option
                  >
                  <option value="Automatiser des processus"
                    >Automatiser des processus</option
                  >
                  <option value="Conseil / autre besoin"
                    >Conseil / autre besoin</option
                  >
                </select>
              </label>
            </div>
            <label class="contact-field mt-4 block">
              Budget envisagé <span class="font-normal text-on-surface-variant"
                >(facultatif)</span
              >
              <select name="budget">
                <option value="Je ne sais pas encore"
                  >Je ne sais pas encore</option
                >
                <option value="Moins de 5 000 €">Moins de 5 000 €</option>
                <option value="Entre 5 000 et 15 000 €"
                  >Entre 5 000 et 15 000 €</option
                >
                <option value="Plus de 15 000 €">Plus de 15 000 €</option>
              </select>
            </label>
            <label class="contact-field mt-4 block">
              Votre projet en quelques lignes
              <textarea
                name="message"
                required
                rows="4"
                minlength="10"
                maxlength="5000"
                placeholder="Contexte, besoin, échéance…"></textarea>
            </label>

            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="contact-website">Site internet</label>
              <input
                id="contact-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <button
              type="submit"
              class="contact-submit mt-6 flex w-full items-center justify-center gap-2 rounded-lg bg-[#1686a8] px-6 py-4 font-bold text-white transition-colors hover:bg-[#0d7595] disabled:cursor-not-allowed disabled:opacity-80"
            >
              <span
                class="contact-spinner hidden h-5 w-5 shrink-0 rounded-full border-2 border-white/40 border-t-white"
                aria-hidden="true"
              >
              </span>
              <span class="contact-submit-label">Envoyer</span>
              <span
                class="material-symbols-outlined contact-submit-arrow text-lg"
                aria-hidden="true">arrow_forward</span
              >
            </button>
            <p class="mt-4 text-center text-xs text-on-surface-variant">
              Vos coordonnées servent uniquement à vous répondre.
              <a class="underline underline-offset-2" href="/mentions-legales"
                >En savoir plus.</a
              >
            </p>
            <p
              class="contact-form-status mt-3 hidden items-center justify-center gap-2 text-center text-sm font-semibold text-error"
              role="alert"
              aria-live="assertive"
            >
              <span class="material-symbols-outlined text-lg" aria-hidden="true"
                >error</span
              >
              <span class="contact-form-status-text"></span>
            </p>
          </form>

          <div
            class="contact-success absolute inset-0 hidden flex-col items-center justify-center gap-1 rounded-2xl bg-white px-6 py-12 text-center"
            role="status"
            aria-live="polite"
          >
            <span class="contact-success-badge" aria-hidden="true">
              <svg viewBox="0 0 52 52" class="contact-success-check">
                <circle cx="26" cy="26" r="24" class="contact-success-ring"
                ></circle>
                <path
                  d="M15 27 l7 7 l15 -16"
                  class="contact-success-tick"
                  fill="none"></path>
              </svg>
            </span>
            <h3
              class="mt-6 font-headline text-2xl font-extrabold text-on-surface"
            >
              Message bien reçu !
            </h3>
            <p
              class="contact-success-text mt-2 max-w-xs text-base leading-7 text-on-surface-variant"
            >
              Merci, nous revenons vers vous sous 24h.
            </p>
            <button
              type="button"
              class="contact-reset mt-7 inline-flex items-center gap-1.5 rounded-lg border border-[#c8d3d9] px-5 py-2.5 text-sm font-bold text-[#1686a8] transition-colors hover:bg-[#f1f8fb]"
            >
              <span
                class="material-symbols-outlined text-base"
                aria-hidden="true">mail</span
              >
              Envoyer un autre message
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-field {
    color: var(--color-on-surface, #191c1e);
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    appearance: none;
    background: white;
    border: 1px solid #c8d3d9;
    border-radius: 0.625rem;
    color: var(--color-on-surface, #191c1e);
    font: inherit;
    font-weight: 400;
    margin-top: 0.375rem;
    padding: 0.7rem 0.85rem;
    width: 100%;
  }

  .contact-field select {
    appearance: auto;
  }

  .contact-field textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: #66757d;
  }

  .contact-field input:focus,
  .contact-field select:focus,
  .contact-field textarea:focus {
    border-color: #1686a8;
    outline: 2px solid #a7deed;
    outline-offset: 1px;
  }

  .contact-spinner {
    animation: contact-spin 0.7s linear infinite;
  }

  @keyframes contact-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Success panel — reveal + animated check */
  .contact-success.is-visible {
    display: flex;
    animation: contact-fade-in 0.35s ease both;
  }

  @keyframes contact-fade-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .contact-success-badge {
    display: inline-flex;
    height: 4.5rem;
    width: 4.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #e4f6ec;
  }

  .contact-success-check {
    height: 3rem;
    width: 3rem;
  }

  .contact-success-ring {
    fill: none;
    stroke: #1c9e63;
    stroke-width: 2.5;
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: contact-draw 0.5s ease-out 0.05s forwards;
  }

  .contact-success-tick {
    stroke: #1c9e63;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: contact-draw 0.35s ease-out 0.4s forwards;
  }

  @keyframes contact-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-spinner,
    .contact-success.is-visible,
    .contact-success-ring,
    .contact-success-tick {
      animation-duration: 0.01ms;
      animation-delay: 0ms;
    }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>(".contact-panel");
  const form = panel?.querySelector<HTMLFormElement>(".contact-form");
  const status = form?.querySelector<HTMLElement>(".contact-form-status");
  const statusText = form?.querySelector<HTMLElement>(
    ".contact-form-status-text",
  );
  const submitButton = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );
  const spinner = form?.querySelector<HTMLElement>(".contact-spinner");
  const submitLabel = form?.querySelector<HTMLElement>(".contact-submit-label");
  const submitArrow = form?.querySelector<HTMLElement>(".contact-submit-arrow");
  const success = panel?.querySelector<HTMLElement>(".contact-success");
  const successText = panel?.querySelector<HTMLElement>(
    ".contact-success-text",
  );
  const resetButton = panel?.querySelector<HTMLButtonElement>(".contact-reset");

  const setSending = (sending: boolean) => {
    if (submitButton) submitButton.disabled = sending;
    spinner?.classList.toggle("hidden", !sending);
    submitArrow?.classList.toggle("hidden", sending);
    if (submitLabel)
      submitLabel.textContent = sending ? "Envoi en cours…" : "Envoyer";
  };

  const showError = (message: string) => {
    if (statusText) statusText.textContent = message;
    status?.classList.remove("hidden");
    status?.classList.add("flex");
  };

  const clearError = () => {
    status?.classList.add("hidden");
    status?.classList.remove("flex");
  };

  const showSuccess = (name: string) => {
    if (successText) {
      const first = name.trim().split(/\s+/)[0];
      successText.textContent = first
        ? `Merci ${first}, nous revenons vers vous sous 24h.`
        : "Merci, nous revenons vers vous sous 24h.";
    }
    form?.classList.add("invisible");
    success?.classList.add("is-visible");
    resetButton?.focus();
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    clearError();
    setSending(true);
    const name = new FormData(form).get("name")?.toString() ?? "";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error);

      form.reset();
      showSuccess(name);
    } catch {
      showError(
        "L’envoi a échoué. Vous pouvez nous écrire à contact@lesaffluentsdunumerique.fr.",
      );
    } finally {
      setSending(false);
    }
  });

  resetButton?.addEventListener("click", () => {
    success?.classList.remove("is-visible");
    form?.classList.remove("invisible");
    form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
  });
</script>
