---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/notre-equipe", label: "Notre Equipe" },
  { href: "/realisations", label: "Nos Réalisations" },
  { href: "/blog", label: "Blog" },
];
---

<header>
  <nav
    class="fixed top-4 left-1/2 -translate-x-1/2 w-[90%] max-w-7xl rounded-xl border border-white/20 bg-surface/80 backdrop-blur-xl shadow-[0_8px_32px_0_rgba(0,51,88,0.1)] flex justify-between items-center px-4 lg:px-8 py-3 z-50"
  >
    <a
      href="/"
      class="text-lg lg:text-xl font-bold tracking-tighter text-primary font-headline flex flex-row items-center gap-2"
      aria-label="Accueil"
    >
      <span
        class="material-symbols-outlined text-3xl lg:text-4xl text-primary-container"
        data-icon="waves"
        aria-hidden="true">waves</span
      >
      <span>{SITE_TITLE}</span>
    </a>
    <div class="hidden lg:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <HeaderLink href={link.href}>{link.label}</HeaderLink>
        ))
      }
    </div>
    <a
      href="#contact"
      class="hidden lg:inline-block bg-primary hover:scale-105 active:scale-100 transition-all duration-300 px-6 py-2 rounded-lg text-on-primary text-sm font-semibold tracking-wide shadow-lg text-center"
    >
      Nous contacter
    </a>
    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden text-primary p-2 hover:bg-surface-container rounded-lg transition-colors relative"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        id="menu-icon"
        class="material-symbols-outlined transition-all block"
        data-icon="menu"
        aria-hidden="true">menu</span
      >
      <span
        id="close-icon"
        class="material-symbols-outlined transition-all absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 pointer-events-none"
        data-icon="close"
        aria-hidden="true">close</span
      >
    </button>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  >
    <nav
      aria-label="Menu de navigation"
      class="fixed top-28 left-1/2 -translate-x-1/2 w-[90%] max-w-md bg-surface rounded-xl shadow-2xl p-6 transform translate-y-[-20px] transition-transform duration-300"
    >
      <div class="flex flex-col gap-4">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-lg font-semibold text-primary hover:bg-surface-container px-4 py-3 rounded-xl transition-colors"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="#contact"
          class="bg-primary hover:scale-105 active:scale-100 transition-all duration-300 px-6 py-3 rounded-lg text-on-primary text-sm font-semibold tracking-wide shadow-lg text-center mt-2"
        >
          Nous contacter
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import "../scripts/mobile-menu.ts";
</script>
