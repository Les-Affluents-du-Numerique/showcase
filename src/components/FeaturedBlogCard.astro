---
import type { CollectionEntry } from "astro:content";
import AuthorList from "@components/AuthorList.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { Image } from "astro:assets";
import { POST_TAGS_ENUM, type PostTagKey } from "../consts";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<section class="mb-20">
  <article
    class="overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest shadow-sm"
  >
    <div
      class:list={[
        "grid",
        post.data.heroImage ? "lg:grid-cols-[1fr_0.72fr]" : "",
      ]}
    >
      <a
        href={`/blog/posts/${post.id}`}
        class="group block p-7 sm:p-10 lg:p-12"
      >
        <div class="grid gap-8 lg:grid-cols-[10rem_1fr] lg:gap-10">
          <div class="space-y-5">
            <span
              class="inline-flex rounded-md bg-primary px-3 py-1 font-label text-[10px] font-bold uppercase tracking-widest text-white"
            >
              À la une
            </span>
            <p class="text-sm text-on-surface-variant">
              <FormattedDate date={post.data.pubDate} />
            </p>
            <AuthorList
              authors={post.data.authors}
              author={post.data.author}
              size="sm"
            />
          </div>
          <div>
            {
              post.data.tags?.length > 0 && (
                <div class="mb-5 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="font-label text-[10px] font-bold uppercase tracking-widest text-primary">
                      {POST_TAGS_ENUM[tag as PostTagKey] ?? tag}
                    </span>
                  ))}
                </div>
              )
            }
            <h2
              class="font-headline text-3xl font-extrabold leading-tight tracking-tight text-primary transition-colors group-hover:text-primary-container sm:text-4xl"
            >
              {post.data.title}
            </h2>
            <p
              class="mt-5 max-w-2xl text-base leading-7 text-on-surface-variant"
            >
              {post.data.description}
            </p>
            <span
              class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-primary"
            >
              Lire l'article
              <span
                class="material-symbols-outlined transition-transform group-hover:translate-x-1"
                aria-hidden="true">arrow_forward</span
              >
            </span>
          </div>
        </div>
      </a>
      {
        post.data.heroImage && (
          <a
            href={`/blog/posts/${post.id}`}
            class="min-h-64 overflow-hidden bg-surface-container"
            aria-label={`Lire ${post.data.title}`}
          >
            <Image
              src={post.data.heroImage}
              alt={post.data.thumbnailAlt || post.data.title}
              width={1000}
              height={750}
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            />
          </a>
        )
      }
    </div>
  </article>
</section>
