---
const today = new Date();
---

<footer
  class="bg-surface-container w-screen relative left-1/2 right-1/2 -mx-[50vw] mt-20"
>
  <div
    class="max-w-7xl mx-auto px-4 md:px-8 py-16 flex flex-col md:flex-row justify-between items-center gap-8"
  >
    <div class="text-center md:text-left">
      <div class="font-headline font-extrabold text-lg text-primary mb-2">
        Les Affluents du Numérique
      </div>
      <p class="font-body text-sm text-on-surface-variant">
        © {today.getFullYear()} Les Affluents du Numérique. Tous droits réservés.
      </p>
    </div>
    <div class="flex gap-8">
      <a
        class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
        href="/mentions-legales">Mentions Légales</a
      >
    </div>
  </div>
</footer>
