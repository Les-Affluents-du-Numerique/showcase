---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  role: string;
  bio: string;
  image: ImageMetadata;
  tech: string[];
}

const { name, role, bio, image, tech } = Astro.props;
---

<article
  class="flex flex-col rounded-2xl p-7 md:p-9 border border-outline-variant/20 bg-surface-container"
>
  <div
    class="mb-8 h-28 w-28 overflow-hidden rounded-full shadow-lg md:h-32 md:w-32"
  >
    <Image
      src={image}
      alt={`Portrait de ${name}`}
      class="h-full w-full object-cover object-top"
      widths={[240, 320]}
      sizes="128px"
    />
  </div>
  <p
    class="mb-3 font-label text-xs font-bold uppercase tracking-[0.14em] text-on-surface-variant"
  >
    {role}
  </p>
  <h3 class="font-headline text-3xl font-extrabold text-primary">
    {name}
  </h3>
  <p class="mt-5 flex-1 text-sm leading-7 text-on-surface-variant">
    {bio}
  </p>
  <ul
    class="mt-7 flex flex-wrap gap-x-3 gap-y-2 border-t pt-5 border-outline-variant/30"
    aria-label={`Technologies maîtrisées par ${name}`}
  >
    {
      tech.map((technology) => (
        <li class="font-label text-xs font-semibold text-primary">
          {technology}
        </li>
      ))
    }
  </ul>
</article>
