---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  role: string;
  bio: string;
  image: ImageMetadata;
  tech: string[];
  variant: "wide" | "tall";
}

const { name, role, bio, image, tech, variant } = Astro.props;
const alt = `Portrait de ${name}`;
---

{
  variant === "wide" ? (
    <article class="flex flex-col items-center gap-8 rounded-2xl border border-outline-variant/20 bg-surface-container p-6 md:col-span-8 md:flex-row md:gap-12 md:p-12">
      <div class="h-28 w-28 shrink-0 overflow-hidden rounded-full shadow-lg lg:h-40 lg:w-40">
        <Image
          src={image}
          alt={alt}
          class="h-full w-full object-cover object-top"
          widths={[240, 320]}
          sizes="160px"
        />
      </div>
      <div>
        <p class="mb-3 font-label text-xs font-bold uppercase tracking-[0.14em] text-on-surface-variant">
          {role}
        </p>
        <h3 class="font-headline text-3xl font-extrabold text-primary">
          {name}
        </h3>
        <p class="mt-5 leading-7 text-on-surface-variant">{bio}</p>
        <ul
          class="mt-7 flex flex-wrap gap-x-3 gap-y-2 border-t border-outline-variant/30 pt-5"
          aria-label={`Technologies maîtrisées par ${name}`}
        >
          {tech.map((technology) => (
            <li class="font-label text-xs font-semibold text-primary">
              {technology}
            </li>
          ))}
        </ul>
      </div>
    </article>
  ) : (
    <article class="flex flex-col justify-between rounded-2xl bg-primary p-7 text-on-primary md:col-span-4 md:p-9">
      <div>
        <div class="mb-8 h-28 w-28 overflow-hidden rounded-xl shadow-xl md:h-32 md:w-32">
          <Image
            src={image}
            alt={alt}
            class="h-full w-full object-cover object-top"
            widths={[240, 320]}
            sizes="128px"
          />
        </div>
        <p class="mb-3 font-label text-xs font-bold uppercase tracking-[0.14em] text-primary-fixed-dim">
          {role}
        </p>
        <h3 class="font-headline text-3xl font-extrabold text-on-primary">
          {name}
        </h3>
        <p class="mt-5 text-sm leading-7 text-on-primary/80">{bio}</p>
      </div>
      <ul
        class="mt-7 flex flex-wrap gap-x-3 gap-y-2 border-t border-white/15 pt-5"
        aria-label={`Technologies maîtrisées par ${name}`}
      >
        {tech.map((technology) => (
          <li class="font-label text-xs font-semibold text-primary-fixed">
            {technology}
          </li>
        ))}
      </ul>
    </article>
  )
}
