---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import Eyebrow from "@components/Eyebrow.astro";
import HeroExpertiseMap from "@components/HeroExpertiseMap.astro";
import { SITE_DESCRIPTIONS, SITE_TITLES } from "../consts";
import { Image } from "astro:assets";
import tissecoLogo from "../assets/tisseco-logo.png";

const siteTitle = SITE_TITLES.home;
const siteDescription = SITE_DESCRIPTIONS.home;
---

<Layout title={siteTitle} description={siteDescription}>
  <!-- Hero Section -->
  <section
    id="main-content"
    class="relative min-h-screen pt-32 pb-20 flex items-center overflow-hidden"
  >
    <!-- Fluid Background Elements -->
    <div
      class="absolute inset-0 -z-10 bg-surface overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-[20%] -left-[10%] w-[60%] h-[80%] rounded-full bg-primary/5 blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-[50%] h-[70%] rounded-full bg-tertiary/5 blur-[120px]"
      >
      </div>
    </div>
    <div
      class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center w-full"
    >
      <div class="lg:col-span-7">
        <Eyebrow class="mb-6">Collectif numérique</Eyebrow>
        <h1
          class="font-headline font-extrabold text-5xl md:text-7xl text-primary leading-[1.1] mb-8 tracking-tight"
        >
          L'excellence <br />
          <span class="text-primary-container">au confluent</span>
          <br />
          du numérique.
        </h1>
        <p
          class="font-body text-lg md:text-xl text-on-surface-variant max-w-xl mb-10 leading-relaxed"
        >
          Un collectif d'experts indépendants en Île-de-France unis pour
          propulser les TPE et PME de Paris et sa région vers de nouveaux
          horizons technologiques. Proximité, agilité et expertise de haut
          niveau.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="fluid-gradient text-on-primary px-8 py-4 rounded-lg font-semibold text-lg shadow-xl hover:scale-[1.02] active:scale-95 transition-transform flex items-center gap-2"
          >
            Contactez-nous
            <span
              class="material-symbols-outlined"
              data-icon="arrow_forward"
              aria-hidden="true">arrow_forward</span
            >
          </a>
          <a
            href="/notre-equipe"
            class="border border-outline-variant text-primary px-8 py-4 rounded-lg font-semibold text-lg hover:bg-surface-container transition-colors flex items-center justify-center"
          >
            Voir notre équipe
          </a>
        </div>
      </div>
      <div class="lg:col-span-5 lg:pl-4">
        <HeroExpertiseMap />
      </div>
    </div>
  </section>
  <!-- Services Bento Grid -->
  <section class="py-28 md:py-36 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="mb-16">
        <h2 class="font-headline font-bold text-4xl text-primary mb-4">
          Nos expertises convergentes
        </h2>
        <p class="font-body text-on-surface-variant max-w-2xl text-lg">
          Nous accompagnons les entreprises d'Île-de-France dans l'ensemble du
          cycle de vie de leurs produits numériques avec une approche
          rigoureuse.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <!-- Web Dev -->
        <div
          class="md:col-span-8 bg-surface-container-lowest rounded-2xl group border border-outline-variant/10 overflow-hidden"
        >
          <div class="h-full flex flex-col justify-between p-8 lg:p-10 gap-6">
            <div>
              <span
                class="material-symbols-outlined text-4xl text-primary mb-6"
                data-icon="terminal"
                aria-hidden="true">terminal</span
              >
              <h3
                class="font-headline font-extrabold text-3xl text-primary mb-4"
              >
                Développement Web
              </h3>
              <p
                class="font-body text-on-surface-variant text-lg max-w-2xl break-words"
              >
                Architectures robustes, interfaces fluides et performances
                optimisées pour vos applications métier et plateformes SaaS.
              </p>
            </div>
            <div>
              <a
                class="inline-flex items-center gap-2 font-semibold text-primary transition-all"
                href="/realisations"
                >Voir nos réalisations <span
                  class="material-symbols-outlined"
                  data-icon="arrow_forward"
                  aria-hidden="true">arrow_forward</span
                ></a
              >
            </div>
          </div>
        </div>
        <!-- Business First -->
        <div
          class="md:col-span-4 bg-tertiary p-8 lg:p-10 rounded-2xl flex flex-col justify-between text-white"
        >
          <div>
            <span
              class="material-symbols-outlined is-filled text-4xl mb-6 text-tertiary-fixed"
              data-icon="business"
              aria-hidden="true">business</span
            >
            <h3 class="font-headline font-extrabold text-2xl mb-4">
              Comprendre avant de construire
            </h3>
            <p class="font-body text-sm leading-relaxed text-white">
              On parle votre métier avant de parler technique.
            </p>
            <p class="mt-3 font-body text-sm leading-relaxed text-white">
              Nous partons de vos enjeux concrets : trésorerie, croissance,
              recrutement, saisonnalité, transformation digitale... Le collectif
              analyse vos besoins réels avant de mobiliser les bonnes
              expertises, avec des solutions pensées pour votre activité et
              expliquées simplement.
            </p>
          </div>
        </div>
        <!-- Blog -->
        <div
          class="md:col-span-4 bg-primary-container p-8 lg:p-10 rounded-2xl flex flex-col justify-between gap-6 border border-white/5"
        >
          <div>
            <span
              class="material-symbols-outlined is-filled text-primary-fixed text-4xl mb-6"
              data-icon="lightbulb"
              aria-hidden="true">lightbulb</span
            >
            <h3 class="font-headline font-extrabold text-white text-2xl mb-4">
              Conseil Stratégique
            </h3>
            <p class="font-body text-sm leading-relaxed text-primary-fixed">
              Audit, architecture et accompagnement dans votre transformation
              numérique. Prenez les bonnes décisions techniques.
            </p>
          </div>
          <div>
            <a
              class="inline-flex items-center gap-2 font-semibold text-white group-hover:gap-4 transition-all"
              href="/blog"
              >Voir nos articles <span
                class="material-symbols-outlined"
                data-icon="arrow_forward"
                aria-hidden="true">arrow_forward</span
              ></a
            >
          </div>
        </div>
        <!-- Flexibility -->
        <div
          class="md:col-span-8 bg-surface-container p-8 lg:p-10 rounded-2xl flex items-center justify-between gap-8 group overflow-hidden border border-outline-variant/10"
        >
          <div class="max-w-md">
            <h3 class="font-headline font-extrabold text-2xl text-primary mb-2">
              Flexibilité Collective
            </h3>
            <p class="font-body text-on-surface-variant">
              Une équipe sur-mesure assemblée selon vos besoins spécifiques, qui
              s'adapte au rythme et à l'évolution de votre projet.
            </p>
          </div>
          <div
            class="hidden sm:flex w-32 h-32 rounded-full bg-white shadow-inner items-center justify-center border border-outline-variant/20"
          >
            <span
              class="material-symbols-outlined text-3xl text-primary"
              data-icon="alt_route"
              aria-hidden="true"
            >
              alt_route
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Why Collective Section (Editorial Layout) -->
  <section class="py-28 md:py-36 bg-surface">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div
        class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-8 mb-16"
      >
        <div class="max-w-2xl">
          <h2
            class="font-headline font-bold text-4xl md:text-5xl text-primary leading-tight"
          >
            Pourquoi choisir un collectif&nbsp;?
          </h2>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16">
        <div>
          <div
            class="text-primary-container font-headline font-extrabold text-5xl opacity-30 mb-4"
          >
            01
          </div>
          <h3 class="font-bold text-xl text-primary mb-3">Proximité Réelle</h3>
          <p class="font-body text-on-surface-variant leading-relaxed">
            Vous échangez directement avec les personnes qui conçoivent et
            réalisent votre solution, du premier rendez-vous à la livraison.
          </p>
        </div>
        <div>
          <div
            class="text-primary-container font-headline font-extrabold text-5xl opacity-30 mb-4"
          >
            02
          </div>
          <h3 class="font-bold text-xl text-primary mb-3">
            Compétences qui font avancer
          </h3>
          <p class="font-body text-on-surface-variant leading-relaxed">
            On arrive avec des outils, des méthodes et des réflexes qui ont déjà
            fait leurs preuves sur le terrain : du concret, directement utile
            pour votre activité. Chaque membre apporte son savoir-faire, rodé
            sur des cas réels.
          </p>
        </div>
        <div>
          <div
            class="text-primary-container font-headline font-extrabold text-5xl opacity-30 mb-4"
          >
            03
          </div>
          <h3 class="font-bold text-xl text-primary mb-3">
            Des moyens bien placés
          </h3>
          <p class="font-body text-on-surface-variant leading-relaxed">
            On investit dans l'essentiel : les relations, les bons outils, et
            surtout le temps passé à produire de la valeur pour vous. Une
            organisation simple, des échanges directs, et chaque euro orienté
            vers le résultat.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Testimonial -->
  <section class="bg-background py-28 md:py-36">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-10 md:mb-12">
        <Eyebrow>Témoignage client</Eyebrow>
        <h2
          class="mt-3 font-headline text-4xl font-extrabold tracking-tight text-primary md:text-5xl"
        >
          On vous laisse la parole.
        </h2>
      </div>

      <figure
        class="grid overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest shadow-sm md:grid-cols-[16rem_1fr]"
      >
        <figcaption
          class="border-b border-outline-variant/30 p-7 md:border-b-0 md:border-r md:p-9"
        >
          <div class="h-16 w-16 rounded-full bg-surface-container p-2">
            <Image
              class="h-full w-full rounded-full object-cover"
              alt="Logo de Tisseco Solidaire"
              src={tissecoLogo}
            />
          </div>
          <div class="mt-5 font-headline text-lg font-bold text-primary">
            Pascale Bruneau
          </div>
          <div
            class="mt-1 text-xs font-label uppercase tracking-wider text-on-surface-variant"
          >
            Présidente<br />Tisseco Solidaire
          </div>
          <div
            class="mt-6 flex gap-0.5 text-primary-container"
            aria-label="5 étoiles sur 5"
          >
            <span
              class="material-symbols-outlined is-filled text-lg"
              aria-hidden="true">star</span
            >
            <span
              class="material-symbols-outlined is-filled text-lg"
              aria-hidden="true">star</span
            >
            <span
              class="material-symbols-outlined is-filled text-lg"
              aria-hidden="true">star</span
            >
            <span
              class="material-symbols-outlined is-filled text-lg"
              aria-hidden="true">star</span
            >
            <span
              class="material-symbols-outlined is-filled text-lg"
              aria-hidden="true">star</span
            >
          </div>
        </figcaption>

        <div class="flex flex-col justify-center p-7 sm:p-10 md:p-12 lg:p-14">
          <span
            class="material-symbols-outlined mb-5 text-4xl text-primary-container"
            aria-hidden="true">format_quote</span
          >
          <blockquote
            class="max-w-3xl font-headline text-2xl font-bold leading-snug tracking-tight text-primary sm:text-3xl"
          >
            Enfin des prestataires qui comprennent les enjeux business des
            petites structures. Un vrai partenaire de croissance.
          </blockquote>
        </div>
      </figure>
    </div>
  </section>
</Layout>
