---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import HomeHero from "@components/home/HomeHero.astro";
import HomeServices from "@components/home/HomeServices.astro";
import HomeWhyCollective from "@components/home/HomeWhyCollective.astro";
import HomeTestimonial from "@components/home/HomeTestimonial.astro";
import { SITE_DESCRIPTIONS, SITE_TITLES } from "../consts";

const siteTitle = SITE_TITLES.home;
const siteDescription = SITE_DESCRIPTIONS.home;
---

<Layout title={siteTitle} description={siteDescription}>
  <!-- Hero Section -->
  <HomeHero />
  <!-- Services Bento Grid -->
  <HomeServices />
  <!-- Why Collective Section (Editorial Layout) -->
  <HomeWhyCollective />
  <!-- Testimonial -->
  <HomeTestimonial />
</Layout>
