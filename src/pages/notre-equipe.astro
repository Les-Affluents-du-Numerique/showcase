---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { SITE_DESCRIPTIONS, SITE_TITLES } from "../consts";
import QuoteCard from "@components/QuoteCard.astro";
import TeamMemberCard from "@components/TeamMemberCard.astro";
import TeamOrbit from "@components/TeamOrbit.astro";
import Eyebrow from "@components/Eyebrow.astro";
import fverinImage from "../assets/francois_verin_profile_picture.webp";
import cdebrayImage from "../assets/christopher_debray_profile_picture.webp";
import dcadeauImage from "../assets/daniel_cadeau_profile_picture.webp";
import jmombongoImage from "../assets/jordan_mombongo_profile_picture.webp";

const team = [
  {
    name: "François Verin",
    role: "Développeur Fullstack",
    bio: "Après plusieurs années en start-up, j'ai choisi de mettre mon expérience au service des entreprises, des plus petites structures aux organisations plus établies. Je conçois des interfaces accessibles et des applications web rapides, robustes et simples à utiliser.",
    image: fverinImage,
    tech: [
      "Next.js",
      "Astro",
      "TypeScript",
      "NestJS",
      "Odoo",
      "PostgreSQL",
      "Docker",
    ],
  },
  {
    name: "Jordan Mombongo",
    role: "Développeur",
    bio: "Spécialisé dans la sécurité des applications web et attaché au Software Craftsmanship, j'interviens sur la conception, la fiabilité et l'évolution de produits métier durables.",
    image: jmombongoImage,
    tech: ["Java", "Spring Boot", "Angular", "Sécurité web"],
  },
  {
    name: "Daniel Cadeau",
    role: "Développeur web",
    bio: "Je conçois, développe et fais évoluer des applications web et des outils métier, du back-end aux interfaces utilisateur. J'interviens également sur la création d'API, la gestion des données et l'intégration de services tiers.",
    image: dcadeauImage,
    tech: ["PHP", "Python", "TypeScript", "SQL", "API", "Docker"],
  },
  {
    name: "Christopher Debray",
    role: "Développeur Fullstack",
    bio: "J'accompagne la conception et le développement d'applications web modernes, avec une approche pragmatique centrée sur des solutions fiables, maintenables et adaptées aux usages réels.",
    image: cdebrayImage,
    tech: ["NestJS", "Next.js", "TypeScript", "Docker"],
  },
];
---

<Layout title={SITE_TITLES.team} description={SITE_DESCRIPTIONS.team}>
  <main id="main-content" class="font-body text-on-background">
    <section class="pb-24 pt-40 md:pb-32 md:pt-44">
      <div
        class="mx-auto grid max-w-7xl items-center gap-16 px-4 md:px-8 lg:grid-cols-12"
      >
        <div class="lg:col-span-7">
          <Eyebrow class="mb-7">Notre équipe</Eyebrow>
          <h1
            class="max-w-4xl font-headline text-5xl font-extrabold leading-[1.04] tracking-tight text-primary md:text-7xl"
          >
            Proximité d'indépendant, avec <span class="text-primary-container"
              >la continuité</span
            > d'une équipe.
          </h1>
          <p
            class="mt-8 max-w-2xl text-lg leading-8 text-on-surface-variant md:text-xl"
          >
            Vous échangez directement avec les développeurs qui conçoivent et
            réalisent votre solution. Si l'un d'entre nous devient indisponible,
            le collectif peut organiser un relais et préserver la continuité du
            projet.
          </p>
        </div>

        <div class="lg:col-span-5">
          <TeamOrbit
            members={team.map(({ name, image }) => ({ name, image }))}
          />
        </div>
      </div>
    </section>

    <section id="membres" class="bg-surface-container-low py-24 md:py-32">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div
          class="mb-14 flex flex-col justify-between gap-6 md:mb-20 md:flex-row md:items-end"
        >
          <div class="max-w-2xl">
            <Eyebrow class="mb-5">Les membres</Eyebrow>
            <h2
              class="font-headline text-4xl font-extrabold leading-tight text-primary md:text-5xl"
            >
              Quatre développeurs, un relais en cas de besoin.
            </h2>
          </div>
          <p class="max-w-md leading-7 text-on-surface-variant">
            Chaque membre reste votre interlocuteur direct. En cas
            d'indisponibilité, un autre membre peut reprendre le contexte et
            assurer la continuité du projet.
          </p>
        </div>

        <div class="grid items-stretch gap-8 md:grid-cols-12">
          <TeamMemberCard {...team[0]} variant="wide" />
          <TeamMemberCard {...team[1]} variant="tall" />

          <div class="col-span-full">
            <QuoteCard />
          </div>

          <TeamMemberCard {...team[2]} variant="tall" />
          <TeamMemberCard {...team[3]} variant="wide" />
        </div>
      </div>
    </section>

    <section class="py-24 md:py-36">
      <div
        class="mx-auto grid max-w-7xl gap-14 px-4 md:px-8 lg:grid-cols-12 lg:gap-20"
      >
        <div class="lg:col-span-5">
          <Eyebrow class="mb-5">Notre fonctionnement</Eyebrow>
          <h2
            class="font-headline text-4xl font-extrabold leading-tight text-primary md:text-5xl"
          >
            La continuité prévue dès le début du projet.
          </h2>
          <p class="mt-6 max-w-md leading-7 text-on-surface-variant">
            Le projet reste suivi par la personne qui le réalise, tout en
            pouvant être repris par le collectif lorsque c'est nécessaire.
          </p>
        </div>

        <ul class="border-t border-outline-variant/50 lg:col-span-7">
          <li
            class="grid gap-4 border-b border-outline-variant/50 py-8 sm:grid-cols-[3.5rem_1fr] sm:gap-6"
          >
            <span
              class="grid h-11 w-11 place-items-center rounded-full bg-primary-fixed text-primary"
              aria-hidden="true"
            >
              <span class="material-symbols-outlined text-xl">person</span>
            </span>
            <div>
              <h3 class="font-headline text-2xl font-bold text-primary">
                Un responsable clairement identifié
              </h3>
              <p class="mt-3 leading-7 text-on-surface-variant">
                La personne qui réalise votre projet en assure directement le
                suivi. Vous savez qui contacter et qui prend les décisions
                techniques.
              </p>
            </div>
          </li>
          <li
            class="grid gap-4 border-b border-outline-variant/50 py-8 sm:grid-cols-[3.5rem_1fr] sm:gap-6"
          >
            <span
              class="grid h-11 w-11 place-items-center rounded-full bg-primary-fixed text-primary"
              aria-hidden="true"
            >
              <span class="material-symbols-outlined text-xl">description</span>
            </span>
            <div>
              <h3 class="font-headline text-2xl font-bold text-primary">
                Un contexte de projet entretenu
              </h3>
              <p class="mt-3 leading-7 text-on-surface-variant">
                Les choix, le périmètre et les points techniques importants sont
                documentés pour faciliter la collaboration et un éventuel
                passage de relais.
              </p>
            </div>
          </li>
          <li
            class="grid gap-4 border-b border-outline-variant/50 py-8 sm:grid-cols-[3.5rem_1fr] sm:gap-6"
          >
            <span
              class="grid h-11 w-11 place-items-center rounded-full bg-primary-fixed text-primary"
              aria-hidden="true"
            >
              <span class="material-symbols-outlined text-xl">sync</span>
            </span>
            <div>
              <h3 class="font-headline text-2xl font-bold text-primary">
                Un relais en cas d'indisponibilité
              </h3>
              <p class="mt-3 leading-7 text-on-surface-variant">
                Un autre membre peut reprendre le contexte et assurer la suite
                du projet. Vous ne dépendez pas d'une seule personne pour
                avancer.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
