---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { SITE_DESCRIPTIONS, SITE_TITLES } from "../consts";
import TeamHero from "@components/team/TeamHero.astro";
import TeamMembers from "@components/team/TeamMembers.astro";
import TeamProcess from "@components/team/TeamProcess.astro";
---

<Layout title={SITE_TITLES.team} description={SITE_DESCRIPTIONS.team}>
  <main id="main-content" class="font-body text-on-background">
    <TeamHero />
    <TeamMembers />
    <TeamProcess />
  </main>
</Layout>
