---
export const prerender = true;

import { getCollection } from "astro:content";
import { type GetStaticPaths, type InferGetStaticPropsType } from "astro";

import BlogListLayout from "@layouts/BlogListLayout.astro";

import {
  POST_TAGS_ENUM,
  type PostTagKey,
  SITE_DESCRIPTIONS,
  SITE_TITLES,
} from "../../consts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog");

  const postsSorted = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // `/blog/` is the canonical first page. Only generate page 2 and above here
  // so `/blog/1/` cannot become a duplicate URL or leak into the sitemap.
  return paginate(postsSorted, { pageSize: 4 }).slice(1);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props;

const allPosts = await getCollection("blog");
const availableTagEntries = Object.entries(POST_TAGS_ENUM).filter(([key]) =>
  allPosts.some((post) => (post.data.tags ?? []).includes(key as PostTagKey)),
);
---

<BlogListLayout
  title={SITE_TITLES.blog}
  description={SITE_DESCRIPTIONS.blogAllCategory}
  availableTagEntries={availableTagEntries}
  gridPosts={page.data}
  pageCurrent={page.currentPage}
  prevHref={page.url.prev ?? null}
  nextHref={page.url.next ?? null}
/>
