---
export const prerender = true;

import { getCollection } from "astro:content";

import BlogListLayout from "@layouts/BlogListLayout.astro";

import {
  POST_TAGS_ENUM,
  type PostTagKey,
  SITE_DESCRIPTIONS,
  SITE_TITLES,
} from "../../../consts";

export const getStaticPaths = async () => {
  const posts = await getCollection("blog");
  const tags = (Object.keys(POST_TAGS_ENUM) as PostTagKey[]).filter((tag) =>
    posts.some((p) => (p.data.tags ?? []).includes(tag)),
  );
  return tags.map((tag) => ({ params: { tag } }));
};

const tag = Astro.params.tag as PostTagKey;

const allPosts = await getCollection("blog");
const postsSorted = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const availableTagEntries = Object.entries(POST_TAGS_ENUM).filter(([key]) =>
  allPosts.some((post) => (post.data.tags ?? []).includes(key as PostTagKey)),
);

const PAGE_SIZE = 4;
const filtered = postsSorted.filter((p) => (p.data.tags ?? []).includes(tag));
const gridPosts = filtered.slice(0, PAGE_SIZE);
const hasNext = filtered.length > PAGE_SIZE;
---

<BlogListLayout
  title={SITE_TITLES.blogCategory[tag] ?? SITE_TITLES.blog}
  description={SITE_DESCRIPTIONS.blogCategory[tag] ??
    SITE_DESCRIPTIONS.blogAllCategory}
  availableTagEntries={availableTagEntries}
  effectiveTag={tag}
  gridPosts={gridPosts}
  pageCurrent={1}
  prevHref={null}
  nextHref={hasNext ? `/blog/${tag}/2` : null}
/>
