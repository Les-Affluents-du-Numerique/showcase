---
export const prerender = true;

import { getCollection } from "astro:content";
import { type GetStaticPaths } from "astro";

import BlogListLayout from "@layouts/BlogListLayout.astro";
import { getIndexableBlogCategories } from "@lib/blog";

import {
  type PostTagKey,
  SITE_DESCRIPTIONS,
  SITE_TITLES,
} from "../../../consts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog");

  const postsSorted = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // The tag index route is the canonical first page. Only generate page 2 and
  // above here; slicing also prevents empty tags from producing a phantom
  // `/blog/<tag>/1/` route that would otherwise leak into the sitemap.
  return getIndexableBlogCategories(posts).flatMap(([tag]) => {
    const filtered = postsSorted.filter((p) =>
      (p.data.tags ?? []).includes(tag),
    );
    return paginate(filtered, { pageSize: 4, params: { tag } }).slice(1);
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const tag = Astro.params.tag as PostTagKey;

const allPosts = await getCollection("blog");
const availableTagEntries = getIndexableBlogCategories(allPosts);
---

<BlogListLayout
  title={SITE_TITLES.blogCategory[tag] ?? SITE_TITLES.blog}
  description={SITE_DESCRIPTIONS.blogCategory[tag] ??
    SITE_DESCRIPTIONS.blogAllCategory}
  availableTagEntries={availableTagEntries}
  effectiveTag={tag}
  gridPosts={page.data}
  pageCurrent={page.currentPage}
  prevHref={page.url.prev ?? null}
  nextHref={page.url.next ?? null}
/>
