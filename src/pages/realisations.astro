---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import RealisationCard from "@components/RealisationCard.astro";
import Eyebrow from "@components/Eyebrow.astro";
import tissecoImage from "../assets/iphone-mockup-tisseco.webp";

const rawProjects = await getCollection("realisations");

const projects = rawProjects
  .map((p) => ({
    ...p,
    _slug: p.id.split("/").pop() ?? p.id,
  }))
  // Sort descending (newest first)
  .sort((a, b) => {
    const aDate = a.data.startDate ? new Date(a.data.startDate).getTime() : 0;
    const bDate = b.data.startDate ? new Date(b.data.startDate).getTime() : 0;
    return bDate - aDate;
  });
---

<Layout
  title={"Les Affluents du Numérique - Nos réalisations"}
  description={"Galerie de projets et études de cas"}
>
  <main id="main-content" class="!pt-40 md:!pt-32">
    <!-- Hero Section -->
    <section class="relative pb-32 px-4 md:px-8 overflow-hidden">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl">
          <Eyebrow class="mb-6">Nos réalisations</Eyebrow>
          <h1
            class="font-headline text-5xl md:text-7xl font-extrabold text-primary leading-[1.1] mb-8 tracking-tighter"
          >
            Des projets qui font leurs
            <span class="editorial-underline">preuves</span>.
          </h1>
          <p
            class="font-body text-xl text-on-surface-variant max-w-2xl leading-relaxed"
          >
            Nous concevons des solutions sur mesure qui allient haute technicité
            et vision stratégique pour des entreprises ambitieuses de toutes
            tailles. Découvrez comment nous accompagnons nos clients, du cadrage
            à la mise en production.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Case Study (Tisseco) -->
    <section
      class="py-24 md:py-36 px-4 md:px-8 overflow-hidden bg-primary text-on-primary"
    >
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div class="relative">
            <div
              class="absolute -top-10 -left-10 w-40 h-40 bg-surface-tint opacity-20 rounded-full blur-3xl"
              aria-hidden="true"
            >
            </div>
            <Image
              alt="Tisseco Solidaire — aperçu"
              class="rounded-xl shadow-2xl relative z-10 w-full object-cover aspect-[4/3]"
              src={tissecoImage}
            />
          </div>
          <div>
            <Eyebrow tone="inverse" class="mb-6">Étude de cas</Eyebrow>
            <h2
              class="font-headline text-4xl md:text-5xl font-extrabold mb-8 leading-tight tracking-tight"
            >
              Tisseco Solidaire — Planification et suivi des tournées
            </h2>
            <div
              class="space-y-6 text-on-primary/80 font-body text-lg leading-relaxed"
            >
              <p>
                Création d'une solution métier pour la planification et le suivi
                des tournées, avec une application mobile pour les chauffeurs et
                une architecture résiliente hors-ligne.
              </p>
              <p>
                Architecture PWA, gestion géospatiale via PostGIS, et
                synchronisation différée pour les zones à faible couverture
                réseau.
              </p>
            </div>
            <div
              class="mt-10 grid lg:grid-cols-2 gap-8 py-8 border-y border-white/10"
            >
              <div>
                <p class="text-3xl font-bold mb-1">Depuis 2025</p>
                <p class="text-on-primary/70 text-sm">Engagement continu</p>
              </div>
              <div>
                <p class="text-3xl font-bold mb-1">Optimisation</p>
                <p class="text-on-primary/70 text-sm">
                  Productivité terrain améliorée
                </p>
              </div>
            </div>
            <a
              class="mt-12 inline-block px-8 py-4 bg-surface-container-lowest text-primary rounded-lg font-bold hover:scale-105 transition-all"
              href="/realisations/tisseco">Lire l'étude complète</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- Project Gallery & Filters -->
    <section class="bg-surface-container-low py-24 px-4 md:px-8">
      <div class="max-w-7xl mx-auto">
        <div
          class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-8"
        >
          <div>
            <h2
              class="font-headline text-4xl font-bold text-primary mb-4 tracking-tight"
            >
              Galerie de projets
            </h2>
            <p class="text-on-surface-variant max-w-md">
              Explorez nos dernières interventions techniques et créatives.
            </p>
          </div>
        </div>

        <!-- Bento Project Grid (from content collection) -->

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projects.map((p, idx) => <RealisationCard project={p} idx={idx} />)}
        </div>
      </div>
    </section>
  </main>
</Layout>
