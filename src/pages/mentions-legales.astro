---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { SITE_DESCRIPTIONS, SITE_TITLES } from "../consts";
import LegalNotice from "@components/legal/LegalNotice.astro";
import PrivacyPolicy from "@components/legal/PrivacyPolicy.astro";

const siteTitle = SITE_TITLES.legalNotices;
const siteDescription = SITE_DESCRIPTIONS.legalNotices;
---

<Layout title={siteTitle} description={siteDescription}>
  <main
    id="main-content"
    class="!pt-40 md:!pt-32 px-6 md:px-8 max-w-4xl mx-auto"
  >
    <LegalNotice />
    <PrivacyPolicy />
  </main>
</Layout>
