---
import Layout from "@layouts/Layout.astro";
import AuthorList from "@components/AuthorList.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("realisations");
  return projects.map((p) => ({
    params: { slug: p.id.split("/").pop() ?? p.id },
  }));
}

const slug = Astro.params.slug as string;
const project = await getEntry("realisations", slug);
if (!project) {
  throw new Error("Project not found");
}

const { Content } = await render(project);
---

<Layout
  title={`Les Affluents du Numérique - ${project.data.title}`}
  description={project.data.description}
>
  <main id="main-content" class="!pt-40 md:!pt-32">
    <section class="max-w-4xl mx-auto px-4 md:px-8 mb-16">
      {
        project.data.hero ? (
          <div class="aspect-video rounded-2xl overflow-hidden mb-8">
            <Image
              src={project.data.hero}
              alt={
                project.data.heroAlt || project.data.title || "Image du projet"
              }
              width={1200}
              height={675}
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-contain object-center bg-surface"
            />
          </div>
        ) : null
      }
      <h1
        class="text-3xl md:text-4xl font-headline font-extrabold text-primary mb-4"
      >
        {project.data.title}
      </h1>
      <p class="text-on-surface-variant mb-6">{project.data.description}</p>
      <div class="flex flex-col gap-4 mb-6">
        <div class="text-sm text-on-surface-variant">
          {
            project.data.startDate ? (
              <span>
                {new Date(project.data.startDate).toLocaleDateString("fr-FR", {
                  month: "long",
                  year: "numeric",
                })}
                {project.data.endDate
                  ? ` — ${new Date(project.data.endDate).toLocaleDateString("fr-FR", { month: "long", year: "numeric" })}`
                  : null}
              </span>
            ) : null
          }
        </div>
        <AuthorList authors={project.data.authors} size="md" />
      </div>
      {
        project.data.tech ? (
          <div class="flex flex-wrap gap-2 mb-8">
            {project.data.tech.map((t) => (
              <span class="px-3 py-1 bg-surface-container text-on-surface-variant text-[0.8rem] font-bold rounded-full">
                {t}
              </span>
            ))}
          </div>
        ) : null
      }
      <div class="prose max-w-none text-on-surface">
        <Content />
      </div>
    </section>
  </main>
</Layout>
